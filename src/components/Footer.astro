---
import { AUTHOR, SOCIAL } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer" data-pagefind-ignore>
	<svg class="swell" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
		<path class="s1" d="M0 26 C 240 0 480 56 720 26 S 1200 0 1440 26 V60 H0Z"></path>
		<path class="s2" d="M0 40 C 260 16 520 64 780 38 S 1240 18 1440 42 V60 H0Z"></path>
	</svg>
	<div class="shell foot-row">
		<span>&copy; {year} {AUTHOR}</span>
		<nav aria-label="页脚链接">
			{SOCIAL.github && <a href={SOCIAL.github} target="_blank" rel="me noopener">GitHub</a>}
			{SOCIAL.x && <a href={SOCIAL.x} target="_blank" rel="me noopener">X</a>}
			{SOCIAL.mastodon && <a href={SOCIAL.mastodon} target="_blank" rel="me noopener">Mastodon</a>}
			{SOCIAL.email && <a href={`mailto:${SOCIAL.email}`}>Email</a>}
			<a href="/rss.xml">RSS</a>
		</nav>
		<span class="serif">Calm seas never made a skilled sailor.</span>
	</div>
</footer>
