---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('zh-CN', {
			// frontmatter 里的纯日期被解析成 UTC 零点，按 UTC 格式化才不会因构建机时区差一天
			timeZone: 'UTC',
			year: 'numeric',
			month: 'long',
			day: 'numeric',
		})
	}
</time>
