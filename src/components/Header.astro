---
import { NAV_LINKS, SITE_TITLE, SOCIAL } from '../consts';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
	href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<div class="nav-wrap" data-pagefind-ignore>
	<header class="nav shell">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} 首页`}>
			<Logo />
			<span>{SITE_TITLE}</span>
		</a>

		<nav class="nav-links" aria-label="主导航">
			{
				NAV_LINKS.map((link) => (
					<a
						href={link.href}
						class:list={{ active: isActive(link.href) }}
						aria-current={isActive(link.href) ? 'page' : undefined}
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="nav-end">
			{
				SOCIAL.github && (
					<a class="icon" href={SOCIAL.github} target="_blank" rel="me noopener" aria-label="GitHub">
						<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
							<path
								fill="currentColor"
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
							></path>
						</svg>
					</a>
				)
			}
			<a class="icon" href="/rss.xml" aria-label="RSS 订阅">
				<svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true">
					<path
						fill="currentColor"
						d="M2 1a1 1 0 0 0 0 2 11 11 0 0 1 11 11 1 1 0 1 0 2 0A13 13 0 0 0 2 1Zm0 4.5a1 1 0 1 0 0 2A6.5 6.5 0 0 1 8.5 14a1 1 0 1 0 2 0A8.5 8.5 0 0 0 2 5.5ZM3.25 11a1.75 1.75 0 1 0 0 3.5 1.75 1.75 0 0 0 0-3.5Z"
					></path>
				</svg>
			</a>
		</div>
	</header>
</div>
