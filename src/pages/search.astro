---
import { SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';

// Pagefind 的索引由 `astro build` 之后的 pagefind CLI 扫 dist/ 生成，
// 所以 dev 下 /pagefind/* 不存在，搜索只在 build + preview 后可用。
const isDev = import.meta.env.DEV;
---

<Base title={`搜索 · ${SITE_TITLE}`} description="全站全文搜索。">
	<Fragment slot="head">
		{!isDev && <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />}
		{!isDev && <script is:inline type="module" src="/pagefind/pagefind-component-ui.js" />}
	</Fragment>

	<section class="shell" data-pagefind-ignore>
		<header class="page-head">
			<div class="eyebrow rise"><b>Sonar</b> Search · 声呐</div>
			<h1 class="section-title rise d1">搜一搜，<span>水下有什么。</span></h1>
		</header>
		<div class="card search-card rise d2">
			{
				isDev ? (
					<p class="hint">
						开发模式下没有搜索索引。跑 <code>npm run build &amp;&amp; npm run preview</code> 再访问这个页面。
					</p>
				) : (
					<Fragment>
						<pagefind-config lang="zh-cn" />
						<pagefind-searchbox placeholder="搜索文章" autofocus="true" show-sub-results="true" />
					</Fragment>
				)
			}
		</div>
	</section>
</Base>
