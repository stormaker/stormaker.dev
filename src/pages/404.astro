---
import { SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
---

<Base title={`页面不存在 · ${SITE_TITLE}`} description="404">
	<section class="shell lost">
		<div class="eyebrow bare rise"><b>404</b> · Off the chart</div>
		<h1 class="section-title rise d1">这片海域，<span>海图上没有。</span></h1>
		<div class="hero-actions rise d2">
			<a class="btn primary" href="/blog/">去看文章</a>
			<a class="btn" href="/search/">搜一搜</a>
		</div>
	</section>
</Base>
