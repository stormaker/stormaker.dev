---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { adjacent, getPublishedPosts, type Post, readingMinutes } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, ...adjacent(posts, post.id) },
	}));
}

type Props = { post: CollectionEntry<'blog'>; prev?: Post; next?: Post };

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost {...post.data} headings={headings} minutes={readingMinutes(post.body)} prev={prev} next={next}>
	<Content />
</BlogPost>
