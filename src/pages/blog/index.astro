---
import PostList from '../../components/PostList.astro';
import { SITE_TITLE } from '../../consts';
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, groupByYear } from '../../lib/posts';

const posts = await getPublishedPosts();
const years = groupByYear(posts);
---

<Base title={`文章 · ${SITE_TITLE}`} description={`全部 ${posts.length} 篇文章，按年份归档。`}>
	<section class="shell">
		<header class="page-head">
			<div class="eyebrow rise"><b>Log</b> Archive · 航海日志</div>
			<h1 class="section-title rise d1">全部文章，<span>共 {posts.length} 篇。</span></h1>
		</header>

		{posts.length === 0 && <p class="empty">还没有文章。</p>}
		{
			years.map(([year, list]) => (
				<section class="year-group">
					<h2 class="year serif">{year}</h2>
					<PostList posts={list} />
				</section>
			))
		}
	</section>
</Base>
