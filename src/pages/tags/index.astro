---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getAllTags } from '../../lib/posts';

const tags = await getAllTags();
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`标签 · ${SITE_TITLE}`} description="按标签浏览全部文章。" />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
			}
			.tag-cloud {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75em;
				padding: 0;
				list-style: none;
			}
			.tag-cloud a {
				display: inline-block;
				padding: 0.3em 0.9em;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
			.tag-cloud a:hover {
				background: var(--accent);
				color: white;
			}
			.count {
				opacity: 0.6;
				font-size: 0.85em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>标签</h1>
			{tags.length === 0 && <p>还没有任何标签。在文章 frontmatter 里加 <code>tags: [xxx]</code> 就会出现在这里。</p>}
			<ul class="tag-cloud">
				{
					tags.map(({ tag, count }) => (
						<li>
							<a href={`/tags/${encodeURIComponent(tag)}/`}>
								#{tag} <span class="count">{count}</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
