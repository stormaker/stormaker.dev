---
import { SITE_TITLE } from '../../consts';
import Base from '../../layouts/Base.astro';
import { getAllTags } from '../../lib/posts';

const tags = await getAllTags();
---

<Base title={`标签 · ${SITE_TITLE}`} description="按标签浏览全部文章。">
	<section class="shell">
		<header class="page-head">
			<div class="eyebrow rise"><b>Routes</b> Tags · 航线</div>
			<h1 class="section-title rise d1">按主题，<span>共 {tags.length} 条航线。</span></h1>
		</header>
		{
			tags.length === 0 ? (
				<p class="empty">
					还没有标签。在文章 frontmatter 里加 <code>tags: [xxx]</code> 就会出现在这里。
				</p>
			) : (
				<div class="topics">
					{tags.map(({ tag, count }) => (
						<a class="chip" href={`/tags/${encodeURIComponent(tag)}/`}>
							#{tag} <span class="count">{count}</span>
						</a>
					))}
				</div>
			)
		}
	</section>
</Base>
